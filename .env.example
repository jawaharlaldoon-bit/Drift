# Runtime
DRIFT_ENV=local
DRIFT_DEMO_MODE=true
DRIFT_REASONING_BACKEND=deterministic
DRIFT_BUILD_REVISION=dev

# Gemini / Google Cloud
GOOGLE_CLOUD_PROJECT=data-shard-504916-r8
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash
FIRESTORE_COLLECTION=drift_incidents
PUBSUB_TOPIC=drift-incidents
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# Guardrails
TRIAGE_CONFIDENCE_THRESHOLD=0.72
GITHUB_OWNER=jawaharlaldoon-bit
GITHUB_REPO=Drift
GITHUB_BASE_BRANCH=main
GITHUB_ALLOWED_PATHS=demo_target/prompts/system.md,demo_target/config/agent-policy.yaml
MAX_PATCH_BYTES=12000

# Secret values: use Secret Manager in Cloud Run. Never commit real values.
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
DEMO_TRIGGER_TOKEN=local-demo-token
DEMO_TARGET_URL=http://localhost:8082

# Local state uses memory. Set firestore in Cloud Run.
STATE_BACKEND=memory
ACTION_MODE=dry-run
